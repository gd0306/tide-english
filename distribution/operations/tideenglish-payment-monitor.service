[Unit]
Description=Tide English payment and settlement alerts
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/tideenglish/operations/payment_health_monitor.py --config /opt/tideenglish/operations/payment-monitor.json
User=root
UMask=0077
StateDirectory=tideenglish-payment-monitor
StateDirectoryMode=0700
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/tideenglish-payment-monitor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
