<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Tide English</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>NSMicrophoneUsageDescription</key><string>Tide English listens while you practise speaking. Native live voice goes to your selected voice provider; turn-based voice is recognised on this iPhone.</string>
<key>NSSpeechRecognitionUsageDescription</key><string>Tide English uses on-device speech recognition for turn-based practice when your model has no native live voice. Recognised text goes to your selected model provider.</string>
<key>NSCameraUsageDescription</key><string>Tide English's voice connection framework includes camera access. Conversations are voice only and do not capture photos or video.</string>
<key>UIBackgroundModes</key><array><string>audio</string></array>
<key>UILaunchScreen</key><dict/>
<key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>TideEnglishEmailAccountsEnabled</key><string>$(TIDE_ENGLISH_EMAIL_ACCOUNTS_ENABLED)</string>
<key>TideEnglishEmailAccountAPIURL</key><string>$(TIDE_ENGLISH_EMAIL_ACCOUNT_API_URL)</string>
<key>TideEnglishManagedAccountsEnabled</key><string>$(TIDE_ENGLISH_MANAGED_ACCOUNTS_ENABLED)</string>
<key>TideEnglishManagedAPIURL</key><string>$(TIDE_ENGLISH_MANAGED_API_URL)</string>
<key>TideEnglishGoogleSignInEnabled</key><string>$(TIDE_ENGLISH_GOOGLE_SIGN_IN_ENABLED)</string>
<key>TideEnglishGoogleClientID</key><string>$(TIDE_ENGLISH_GOOGLE_CLIENT_ID)</string>
<key>TideEnglishAppleSignInEnabled</key><string>$(TIDE_ENGLISH_APPLE_SIGN_IN_ENABLED)</string>
<key>TideEnglishAppleClientID</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>TideEnglishApplePurchasesEnabled</key><string>$(TIDE_ENGLISH_APPLE_PURCHASES_ENABLED)</string>
<key>TideEnglishApplePurchaseEnvironment</key><string>$(TIDE_ENGLISH_APPLE_PURCHASE_ENVIRONMENT)</string>
<key>SKIncludeConsumableInAppPurchaseHistory</key><true/>
<key>CFBundleURLTypes</key><array><dict>
<key>CFBundleTypeRole</key><string>Editor</string>
<key>CFBundleURLName</key><string>Google sign-in</string>
<key>CFBundleURLSchemes</key><array><string>$(TIDE_ENGLISH_GOOGLE_CALLBACK_SCHEME)</string></array>
</dict></array>
</dict></plist>
